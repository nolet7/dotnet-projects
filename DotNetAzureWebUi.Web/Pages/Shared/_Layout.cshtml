<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DotNet Azure Web UI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="brand">
            <span class="brand-icon">.NET</span>
            <span>Azure Web UI</span>
        </div>
        <nav>
            <a asp-page="/Index">Home</a>
            <a asp-page="/Privacy">Privacy</a>
            <a href="/api/health">Health</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <p>Built with ASP.NET Core, Azure DevOps, and Azure App Service.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
